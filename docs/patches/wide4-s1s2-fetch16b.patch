+    wire [TAG_BITS-1:0] fetch_tag5 = fetch_pc5[ADDR_BITS-1:IDX_BITS+2];
+    wire fetch_hit5 = in_range(fetch_pc5) && valid_q[fetch_idx5] && (tag_q[fetch_idx5]==fetch_tag5);
