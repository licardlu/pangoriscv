# 45 MHz on the CORE clock (period 22.2222 ns) -- P15 DELIVERY constraint.
#
# Why 45 and not 50: at a 20 ns target the placement closes (WNS +1.036 ns, TNS 0)
# but detailed routing never converges -- unrouted nets went 18,810 @7 -> 11,549 @21
# and the slope flattened to ~240/iteration, the congestion fingerprint of
# mistakes-log 48 (oscillation, not convergence).  At 22.22 ns the same netlist has
# ~3 ns of placement slack, which is what the router needs on this design.
#
# Hardware chain: 27 MHz on D18 -> GTP_PPLL I=1/M=1/F=50/O0=30 -> 27*50/30 = 45.000 MHz.
# VCO = 1350 MHz (legal 1330..2133).  120.000 MHz is NOT reachable on this PLL
# (needs F/M = 40/9 -> VCO 1080 or 2160, both illegal); see plan v10 section 1.
create_clock -name board_clk -period 37.037037 -waveform {0 18.5185185} [get_ports {clk}]
create_clock -name core_clk -period 22.222222 -waveform {0 11.111111} [get_pins {u_core_pll/CLKOUT0}]
