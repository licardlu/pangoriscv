# MES2L676-100HP (PG2L100H-6IFBG676, board version V1.2).
# Every LOC below was re-confirmed against official board material in the board-material
# audit round; NO pin value was changed. Evidence (per pin, with page/line numbers) is in
# the project validation archive:
#   * 教程1_硬件实验指导手册_盘古676系列100Pro+开发板.pdf  (KEY0..KEY4, UART, LED, 27MHz clock, bank L3)
#   * official demos 2_8_uart_test/uart_test.fdc, 2_7_key_led_test/key_led_test.fdc,
#     4_1_led_test/led_test.fdc  (same LOCs, VCCIO=3.3, LVCMOS33)
# * rst_n/KEY0 = C22 and key/KEY1 = C23: both are active-low push buttons (manual:
#   "按键连接在 FPGA 普通 IO 上，低电平有效"); the vendor demos name them rstn/key.
# Full provenance is also recorded in README.md.
def_port {clk} LOC=D18 VCCIO=3.3 IOSTANDARD=LVCMOS33 NONE=TRUE
def_port {rst_n} LOC=C22 VCCIO=3.3 IOSTANDARD=LVCMOS33 NONE=TRUE
def_port {key} LOC=C23 VCCIO=3.3 IOSTANDARD=LVCMOS33 NONE=TRUE
def_port {uart_rx} LOC=B24 VCCIO=3.3 IOSTANDARD=LVCMOS33 NONE=TRUE
def_port {uart_tx} LOC=C24 VCCIO=3.3 IOSTANDARD=LVCMOS33 DRIVE=8 SLEW=SLOW NONE=TRUE
def_port {led[0]} LOC=A20 VCCIO=3.3 IOSTANDARD=LVCMOS33 DRIVE=8 SLEW=SLOW NONE=TRUE
def_port {led[1]} LOC=C18 VCCIO=3.3 IOSTANDARD=LVCMOS33 DRIVE=8 SLEW=SLOW NONE=TRUE
def_port {led[2]} LOC=C19 VCCIO=3.3 IOSTANDARD=LVCMOS33 DRIVE=8 SLEW=SLOW NONE=TRUE
def_port {led[3]} LOC=E18 VCCIO=3.3 IOSTANDARD=LVCMOS33 DRIVE=8 SLEW=SLOW NONE=TRUE
def_port {led[4]} LOC=A17 VCCIO=3.3 IOSTANDARD=LVCMOS33 DRIVE=8 SLEW=SLOW NONE=TRUE
def_port {led[5]} LOC=A18 VCCIO=3.3 IOSTANDARD=LVCMOS33 DRIVE=8 SLEW=SLOW NONE=TRUE
def_port {led[6]} LOC=C17 VCCIO=3.3 IOSTANDARD=LVCMOS33 DRIVE=8 SLEW=SLOW NONE=TRUE
def_port {led[7]} LOC=B17 VCCIO=3.3 IOSTANDARD=LVCMOS33 DRIVE=8 SLEW=SLOW NONE=TRUE
