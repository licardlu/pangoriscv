     input  wire [31:0] fetch_pc3,
     output wire        predict_taken3,
     output wire [31:0] predict_target3,
+    // ---- M1-S2: ports 4 and 5, the 16 B fetch chain -----------------------
+    // A 16 B fetch needs the predicted successor of all four words it carries
+    // (base+0/4/8/12).  With only two chain ports the 3rd/4th words had to be
+    // assumed sequential, and every conditional branch living there became a
+    // mispredict: measured 46,285 -> 140,677 per 20 iterations, which cost 19%
+    // more ticks than it saved (plan v18 section 6).  A flop-based table makes
+    // these ports only two more index/tag compares.
+    input  wire [31:0] fetch_pc4,
+    output wire        predict_taken4,
+    output wire [31:0] predict_target4,
+    input  wire [31:0] fetch_pc5,
+    output wire        predict_taken5,
+    output wire [31:0] predict_target5,
     // ---- training at the real completion boundary (retire) ---------------
     input wire        train_valid,          // retire_fire
     input wire [31:0] train_pc,             // retired PC
@@ -119,6 +132,18 @@ module branch_predictor #(
     assign predict_taken3  = fetch_hit3 && (uncond_q[fetch_idx3] || count_q[fetch_idx3][1]);
     assign predict_target3 = {{(32-ADDR_BITS){1'b0}}, target_q[fetch_idx3]};
 
+    wire [IDX_BITS-1:0] fetch_idx4 = fetch_pc4[IDX_BITS+1:2];
+    wire [TAG_BITS-1:0] fetch_tag4 = fetch_pc4[ADDR_BITS-1:IDX_BITS+2];
+    wire fetch_hit4 = in_range(fetch_pc4) && valid_q[fetch_idx4] && (tag_q[fetch_idx4]==fetch_tag4);
+    assign predict_taken4  = fetch_hit4 && (uncond_q[fetch_idx4] || count_q[fetch_idx4][1]);
+    assign predict_target4 = {{(32-ADDR_BITS){1'b0}}, target_q[fetch_idx4]};
