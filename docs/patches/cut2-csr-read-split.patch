                 w_pc_h <= m_pc_h; w_value_h <= m_value_h;
                 w_rd_h <= m_rd_h; w_we_h <= m_we_h;
                 w_ctrl_h <= m_ctrl_h; w_taken_h <= m_taken_h;
@@ -1234,8 +1241,14 @@ module rv32_top(
         // empty -- otherwise one killed CSR locks the core out of fetching
