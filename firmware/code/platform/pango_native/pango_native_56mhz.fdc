# 56 MHz on the CORE clock (period 17.857143 ns).
#
# Hardware chain: 27 MHz on D18 -> GTP_PPLL I=1/M=1/F=56/O0=27 -> 27 x 56/27 = 56.000 MHz.
# VCO = 27 x 56 = 1512 MHz (legal 1330..2133).
#
# Ladder position: 50 MHz is the delivered rung.  This rung only exists because
# the deferred D$ write port (cut 6) takes 4.77 ns out of the routed critical
# path, so the old "50 MHz is the ceiling" measurement no longer applies.
create_clock -name board_clk -period 37.037037 -waveform {0 18.5185185} [get_ports {clk}]
create_clock -name core_clk -period 17.857143 -waveform {0 8.9285715} [get_pins {u_core_pll/CLKOUT0}]
