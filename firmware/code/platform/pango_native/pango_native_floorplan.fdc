# pango_native_floorplan.fdc -- P14 modular floorplanning (FDC PAP_REGION channel).
#
# Channel note (mistakes-log 46/47, P13 isolation experiments): the PCF
# def_inst_region form makes pnr die 15 s after "Constraint check end" with
# "E: Failed to execute the script" whenever ANY instance binding is present
# (regions alone are fine).  The FDC PAP_REGION attribute channel survives
# dev_map -- this file is merged into the staged frequency FDC by run_pds_flow.
#
# Geometry: x layout unchanged from the calibrated v2 PCF (probe builds
# p13fpcal/p13fpcal2: legal space x 0..122, y 0..203).  y band [20,183] forces
# vertical packing -- the 24.65 ns critical path is 82.5% ROUTE with the
# four path modules (cpu/dcache/ifu/icache) scattered over the full die
# height.  APM column x=86 must stay inside R_CORE; data_ram (LUTRAM) needs
# CLMA columns so it sits in R_DCACHE, not on a DRM column.
#
#   x 10        28 30      50  58        88  90        108 110    117
#     [ R_ICACHE ][ R_FETCH][   R_CORE   ][  R_DCACHE  ][  R_IO  ]
#
define_global_attribute {PAP_REGION} {R_ICACHE(10,28,0,199);R_FETCH(30,50,0,199);R_CORE(58,88,0,199);R_DCACHE(90,108,0,199);R_IO(110,117,0,199)}
define_attribute {i:soc.core.instruction_cache} {PAP_REGION} {R_ICACHE}
define_attribute {i:soc.program_ram} {PAP_REGION} {R_ICACHE}
define_attribute {i:soc.core.ifu} {PAP_REGION} {R_FETCH}
define_attribute {i:soc.core.cpu.u_bp} {PAP_REGION} {R_FETCH}
define_attribute {i:soc.core.cpu} {PAP_REGION} {R_CORE}
define_attribute {i:soc.core.data_cache} {PAP_REGION} {R_DCACHE}
define_attribute {i:soc.core.lsu} {PAP_REGION} {R_DCACHE}
define_attribute {i:soc.data_ram} {PAP_REGION} {R_DCACHE}
define_attribute {i:soc.fabric} {PAP_REGION} {R_IO}
define_attribute {i:soc.uart_inst} {PAP_REGION} {R_IO}
define_attribute {i:soc.gpio_inst} {PAP_REGION} {R_IO}
define_attribute {i:soc.timer_inst} {PAP_REGION} {R_IO}
define_attribute {i:soc.spi_inst} {PAP_REGION} {R_IO}
define_attribute {i:soc.irq_inst} {PAP_REGION} {R_IO}
