# 52 MHz on the CORE clock (period 19.230769 ns).
#
# Hardware chain: 27 MHz on D18 -> GTP_PPLL I=1/M=1/F=52/O0=27 -> 27 x 52/27 = 52.000 MHz.
# VCO = 27 x 52 = 1404 MHz (legal 1330..2133).
#
# Ladder position: 39 MHz is the delivered baseline, 45 MHz is the first rung that
# the redirect cut + byte-lane D\$ could reach, and this rung exists so the next
# frequency step needs no new constraint file.
create_clock -name board_clk -period 37.037037 -waveform {0 18.5185185} [get_ports {clk}]
create_clock -name core_clk -period 19.230769 -waveform {0 9.6153845} [get_pins {u_core_pll/CLKOUT0}]
