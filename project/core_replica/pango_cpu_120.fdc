# pango_cpu_120.fdc -- 目标版本约束 (与参考同一时钟方案)
# 27 MHz 晶振; GTP_PPLL 27 x 58 / 13 = 120.461538 MHz, VCO 1566 MHz
create_clock -name board_clk -period 37.037037037 -waveform {0 18.518518519} [get_ports clk]
create_clock -name core_clk  -period 8.301404853   -waveform {0 4.150702427}  [get_pins u_core_pll/u_ppll/CLKOUT0]
