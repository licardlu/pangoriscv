# 统一换行：仓库内存 LF，检出时按平台转换
* text=auto eol=lf

# Windows 脚本保留 CRLF，避免部署脚本因换行损坏
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制：不做换行转换、不做文本 diff
*.png   binary
*.jpg   binary
*.jpeg  binary
*.pdf   binary
*.zip   binary
*.sbit  binary
*.bit   binary
*.wlf   binary
*.vstf  binary
*.gif   binary
