# 51 MHz on the CORE clock (period 19.607843 ns).
#
# Hardware chain: 27 MHz on D18 -> GTP_PPLL I=1/M=1/F=51/O0=27 -> 27 x 51/27 = 51.000 MHz.
# VCO = 27 x 51 = 1377 MHz (legal 1330..2133), PFD 27 MHz.
#
# ONE clock only.  P48e measured that the extra "whip" clock is what broke the
# 50 MHz attempts: declaring 19.231 ns routed to 21.60 / 21.12 ns, while a single
# 20.000 ns declaration routed to 19.355 ns.  So every rung from here on declares
# exactly its own period and nothing tighter.
create_clock -name board_clk -period 37.037037 -waveform {0 18.5185185} [get_ports {clk}]
create_clock -name core_clk -period 19.607843 -waveform {0 9.8039215} [get_pins {u_core_pll/CLKOUT0}]
