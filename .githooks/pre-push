#!/bin/sh
# =============================================================================
# pre-push：禁止把仿真跑分数据推到远端
#
# 理由：没有物理开发板时，CoreMark 分数只能来自 ModelSim 仿真；赛题要求分数必须
# 来自 FPGA 板上真实运行，所以这些数据不是有效成绩，不得上传。
# 本钩子是强制拦截，不依赖任何人记得去读文档。详见仓库根 SCORE-STATUS.txt。
#
# 启用： git config core.hooksPath .githooks
# =============================================================================
BLOCK_PATH='evidence/records/coremark-sim-'
ZERO=0000000000000000000000000000000000000000
blocked=0

while read -r local_ref local_sha remote_ref remote_sha; do
    # 删除远端分支：没有新增内容
    [ "$local_sha" = "$ZERO" ] && continue
    if [ "$remote_sha" = "$ZERO" ]; then
        commits=$(git rev-list "$local_sha" --not --remotes 2>/dev/null)
    else
        commits=$(git rev-list "$remote_sha..$local_sha" 2>/dev/null)
    fi
    for c in $commits; do
        if git ls-tree -r --name-only "$c" 2>/dev/null | grep -q "^$BLOCK_PATH"; then
            echo "pre-push 拒绝：提交 $c 含仿真跑分数据（${BLOCK_PATH}*）。" >&2
            blocked=1
        fi
    done
done

if [ "$blocked" -ne 0 ]; then
    cat >&2 <<'EOF'

这些数据不是有效成绩：本轮没有物理开发板，跑分全部来自 ModelSim 仿真，
而赛题要求分数必须来自 FPGA 板上真实运行。

处理办法：
  1) 查是否被跟踪：      git ls-files | grep coremark-sim
  2) 若被跟踪，取消跟踪：git rm -r --cached evidence/records/coremark-sim-2026-10-17
  3) 若已进历史提交：未 push 前可 git reset --soft <基线> 重做，或改写历史
详见 SCORE-STATUS.txt 与 evidence/records/coremark-sim-2026-10-17/DO-NOT-UPLOAD.txt
EOF
    exit 1
fi
exit 0
